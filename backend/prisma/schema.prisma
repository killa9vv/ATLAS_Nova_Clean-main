generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusPedido {
  CRIADO
  AGUARDANDO_PAGAMENTO
  PAGO
  CANCELADO
  ESTORNADO
}

enum StatusPagamento {
  PENDENTE
  EM_PROCESSAMENTO
  APROVADO
  RECUSADO
  CANCELADO
  ESTORNADO
  EXPIRADO
}

enum MetodoPagamento {
  PIX
  CARTAO_CREDITO
}

enum PapelUsuario {
  ADMIN
}

enum TipoDesconto {
  PERCENTUAL
  VALOR_FIXO
}

model Categoria {
  id   String @id @default(uuid())
  slug String @unique
  nome String

  produtoTipos ProdutoTipo[]

  @@map("categorias")
}

model Marca {
  id   String @id @default(uuid())
  nome String @unique

  produtos Produto[]

  @@map("marcas")
}

// Produto genérico (ex: "Detergente para Louça"), independente de marca. Cada
// linha de Produto é uma variante vendável desse tipo (marca + embalagem + preço).
model ProdutoTipo {
  id          String  @id @default(uuid())
  categoriaId String  @map("categoria_id")
  nome        String
  // Texto técnico/precauções padrão do tipo — sobreposição por variante (existe
  // no catálogo do frontend como ProductVariant.info/precautions) não tem campo
  // aqui: nenhum dado real usa isso hoje, fica pra quando existir de verdade.
  infoTecnica String? @map("info_tecnica")
  precaucoes  String?

  categoria Categoria @relation(fields: [categoriaId], references: [id])
  produtos  Produto[]

  @@unique([categoriaId, nome])
  @@index([categoriaId])
  @@map("produto_tipos")
}

model Produto {
  id            String   @id @default(uuid())
  produtoTipoId String   @map("produto_tipo_id")
  marcaId       String   @map("marca_id")
  nome          String
  pack          String
  descricao     String?
  preco         Decimal  @db.Decimal(10, 2)
  estoque       Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  produtoTipo ProdutoTipo  @relation(fields: [produtoTipoId], references: [id])
  marca       Marca        @relation(fields: [marcaId], references: [id])
  itensPedido ItemPedido[]

  @@index([produtoTipoId])
  @@index([marcaId])
  @@map("produtos")
}

model Usuario {
  id        String       @id @default(uuid())
  email     String       @unique
  senhaHash String       @map("senha_hash")
  nome      String
  papel     PapelUsuario @default(ADMIN)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  @@map("usuarios")
}

model Cliente {
  id        String   @id @default(uuid())
  nome      String
  email     String?  @unique
  telefone  String?
  cpf       String?
  createdAt DateTime @default(now()) @map("created_at")

  enderecos Endereco[]
  pedidos   Pedido[]

  @@map("clientes")
}

model Endereco {
  id          String  @id @default(uuid())
  clienteId   String  @map("cliente_id")
  cep         String
  logradouro  String
  numero      String
  complemento String?
  bairro      String
  cidade      String
  estado      String

  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@map("enderecos")
}

model Cupom {
  id          String       @id @default(uuid())
  codigo      String       @unique
  tipoDesconto TipoDesconto @map("tipo_desconto")
  valor       Decimal      @db.Decimal(10, 2)
  ativo       Boolean      @default(true)
  validoAte   DateTime?    @map("valido_ate")
  usoMaximo   Int?         @map("uso_maximo")
  usosCount   Int          @default(0) @map("usos_count")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("cupons")
}

model Pedido {
  id          String       @id @default(uuid())
  clienteId   String?      @map("cliente_id")
  status      StatusPedido @default(CRIADO)
  total       Decimal      @db.Decimal(10, 2)
  desconto    Decimal      @default(0) @db.Decimal(10, 2)
  cupomCodigo String?      @map("cupom_codigo")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  cliente    Cliente?     @relation(fields: [clienteId], references: [id])
  itens      ItemPedido[]
  pagamentos Pagamento[]

  @@index([clienteId])
  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(uuid())
  pedidoId      String  @map("pedido_id")
  produtoId     String  @map("produto_id")
  nome          String
  quantidade    Int
  precoUnitario Decimal @map("preco_unitario") @db.Decimal(10, 2)

  pedido  Pedido  @relation(fields: [pedidoId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@map("itens_pedido")
}

model Pagamento {
  id                   String          @id @default(uuid())
  pedidoId             String          @map("pedido_id")
  metodo               MetodoPagamento
  status               StatusPagamento @default(PENDENTE)
  valor                Decimal         @db.Decimal(10, 2)
  gatewayTransactionId String?         @unique @map("gateway_transaction_id")
  gatewayPayload        Json?          @map("gateway_payload")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  @@index([pedidoId])
  @@map("pagamentos")
}
