# Banco de dados
DATABASE_URL="postgresql://usuario:senha@localhost:5432/atlas_nova_clean?schema=public"

# Aplicação
PORT=3000
# Origens permitidas por CORS, separadas por vírgula. Vazio/ausente = libera geral (só p/ dev).
CORS_ORIGIN=

# Mercado Pago (https://www.mercadopago.com.br/developers/panel/app)
#
# Em produção: use as credenciais de PRODUÇÃO da sua conta real (verificada,
# com chave Pix/dados bancários cadastrados), aba "Credenciais de produção"
# da aplicação — token começa com APP_USR-.
#
# Em desenvolvimento local: dá pra usar credenciais de uma conta de teste
# (Contas de teste → Vendedor → criar → dentro dela, criar uma aplicação →
# Credenciais de produção da conta de teste). Mas atenção: mesmo assim pode
# aparecer o erro "Unauthorized use of live credentials" dependendo da conta —
# isso é uma restrição do lado do Mercado Pago, não do código. Validamos que
# o backend monta a requisição corretamente; se acontecer, é caso pra suporte
# deles ou pra testar direto com credenciais de produção reais.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
# URL pública (HTTPS) para onde o Mercado Pago envia as notificações de webhook.
# Obrigatório ter HTTPS válido em produção — localhost não funciona.
MERCADOPAGO_NOTIFICATION_URL="https://seu-dominio.com/pagamentos/webhook"
