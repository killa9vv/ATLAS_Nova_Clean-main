{
  "name": "atlas-nova-clean",
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "backend/node_modules/.bin/eslint --fix",
      "backend/node_modules/.bin/prettier --write"
    ],
    "atlas-nova-clean-loja/**/*.{js,css,html}": [
      "backend/node_modules/.bin/prettier --write"
    ],
    "frontend/**/*.{ts,tsx}": [
      "frontend/node_modules/.bin/eslint --config frontend/eslint.config.mjs --fix",
      "frontend/node_modules/.bin/prettier --write"
    ],
    "frontend/**/*.{css,mjs,json}": [
      "frontend/node_modules/.bin/prettier --write"
    ]
  }
}
