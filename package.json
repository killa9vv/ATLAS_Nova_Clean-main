{
  "name": "atlas-nova-clean",
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "lint-staged": {
    "Código-fonte/backend/**/*.ts": [
      "Código-fonte/backend/node_modules/.bin/eslint --fix",
      "Código-fonte/backend/node_modules/.bin/prettier --write"
    ],
    "Código-fonte/atlas-nova-clean-loja/**/*.{js,css,html}": [
      "Código-fonte/backend/node_modules/.bin/prettier --write"
    ],
    "Código-fonte/frontend/**/*.{ts,tsx}": [
      "Código-fonte/frontend/node_modules/.bin/eslint --config Código-fonte/frontend/eslint.config.mjs --fix",
      "Código-fonte/frontend/node_modules/.bin/prettier --write"
    ],
    "Código-fonte/frontend/**/*.{css,mjs,json}": [
      "Código-fonte/frontend/node_modules/.bin/prettier --write"
    ]
  }
}
