# Variáveis validadas na subida da aplicação (src/shared/config/env-validation.schema.ts)
# — falta ou formato errado de DATABASE_URL/JWT_SECRET impede a API de subir, com uma
# mensagem clara apontando qual variável está errada.

# Banco de dados (obrigatória). Valores abaixo já batem com os defaults de
# `npm run dev` (Postgres embarcado, sem Docker) E do `docker compose up`
# (docker-compose.yml) — são credenciais só de desenvolvimento local, sem valor
# real, então não tem problema estarem em texto plano aqui. Troque se quiser.
DATABASE_URL="postgresql://atlas:atlas@localhost:5433/atlas_nova_clean?schema=public"

# Usadas pelo serviço `postgres` do docker-compose.yml (via variável de ambiente do
# compose, não lidas pela API diretamente). Devem refletir o usuário/senha/banco
# acima em DATABASE_URL. POSTGRES_PORT é a porta no HOST (localhost) — 5433 por
# padrão pra não colidir com uma instalação nativa de Postgres no Windows (que
# costuma ocupar a 5432).
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas_nova_clean
POSTGRES_PORT=5433

# Autenticação (login JWT — ver src/auth). Obrigatória, mínimo 16 caracteres. O
# valor abaixo é só pra `docker compose up`/`npm run dev` funcionarem sem editar
# nada — gere um valor forte e único por ambiente real (staging/produção), ex:
# openssl rand -base64 48. NUNCA reaproveite este valor fora de dev local.
JWT_SECRET="dev-local-nao-use-em-producao-troque-este-valor"

# Aplicação
PORT=3000
# Origens permitidas por CORS, separadas por vírgula. Vazio/ausente = libera geral (só p/ dev).
CORS_ORIGIN=

# Mercado Pago (https://www.mercadopago.com.br/developers/panel/app)
#
# Em produção: use as credenciais de PRODUÇÃO da sua conta real (verificada,
# com chave Pix/dados bancários cadastrados), aba "Credenciais de produção"
# da aplicação — token começa com APP_USR-.
#
# Em desenvolvimento local: dá pra usar credenciais de uma conta de teste
# (Contas de teste → Vendedor → criar → dentro dela, criar uma aplicação →
# Credenciais de produção da conta de teste). Mas atenção: mesmo assim pode
# aparecer o erro "Unauthorized use of live credentials" dependendo da conta —
# isso é uma restrição do lado do Mercado Pago, não do código. Validamos que
# o backend monta a requisição corretamente; se acontecer, é caso pra suporte
# deles ou pra testar direto com credenciais de produção reais.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
# URL pública (HTTPS) para onde o Mercado Pago envia as notificações de webhook.
# Obrigatório ter HTTPS válido em produção — localhost não funciona.
MERCADOPAGO_NOTIFICATION_URL="https://seu-dominio.com/pagamentos/webhook"

# Cloudinary (https://console.cloudinary.com — free tier cobre o uso atual do projeto)
# Usado pro upload de imagens de produto (POST /produtos/:id/imagens). As três vêm
# do dashboard do Cloudinary, aba "Product Environment Credentials".
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Frete (src/frete) — todas opcionais: sem MELHOR_ENVIO_TOKEN/FRETE_CEP_ORIGEM, a
# cotação usa só a tabela regional própria (ShippingQuoteProviderComFallback cai
# pra ela automaticamente); com as duas configuradas, tenta a API do Melhor Envio
# primeiro e só usa a tabela se a API falhar/expirar o timeout.
#
# Token de acesso gerado no painel do Melhor Envio (não é OAuth automático aqui —
# mesma convenção do MERCADOPAGO_ACCESS_TOKEN acima: gere e cole o token pronto).
MELHOR_ENVIO_TOKEN=""
# Vazio/ausente = usa a API de produção do Melhor Envio. Aponte pra
# https://sandbox.melhorenvio.com.br em desenvolvimento pra testar sem gerar etiquetas reais.
MELHOR_ENVIO_BASE_URL=""
# CEP de origem dos envios (loja/CD), só dígitos ou com máscara.
FRETE_CEP_ORIGEM=""
# Valor de subtotal do carrinho a partir do qual o frete de ENTREGA vira grátis.
# Vazio/ausente = regra desligada (nenhum pedido se qualifica).
FRETE_GRATIS_ACIMA_DE=

# pgAdmin (opcional — só sobe com `docker compose --profile tools up`, ver
# docs/local-setup.md). Login usado na UI web do pgAdmin, não é credencial do
# Postgres em si.
PGADMIN_EMAIL=dev@atlas.local
PGADMIN_PASSWORD=atlas
