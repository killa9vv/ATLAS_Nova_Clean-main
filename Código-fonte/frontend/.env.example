# URL da API (NestJS). Precisa do prefixo NEXT_PUBLIC_ pra ficar disponível no browser
# (Next.js só expõe variáveis com esse prefixo pro código client-side).
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# Número de WhatsApp da loja pra onde o checkout redireciona ao fechar pedido —
# formato E.164 sem "+" (ex.: 5522999998888).
NEXT_PUBLIC_WHATSAPP_NUMERO="5522999998888"

# Public Key do Mercado Pago (Payment Brick) — diferente do Access Token (que fica só
# no backend), essa é feita pra ser exposta no frontend. Precisa bater com o Access
# Token configurado no MERCADOPAGO_ACCESS_TOKEN do backend. O valor abaixo é de uma
# conta de TESTE (sandbox), só serve pra desenvolvimento local — troque pela Public
# Key de produção antes de publicar (painel Mercado Pago → Credenciais de produção).
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="TEST-fa9ad04f-891d-490e-9ba5-a3e5ca052899"
